rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection check path
    match /test/{docId} {
      allow read: if true;
    }

    // Organisers profile collection
    match /organisers/{organiserId} {
      allow read: if true;
      allow create, update: if (request.auth != null && request.auth.uid == organiserId) || organiserId.matches('^guest_.*');
      allow delete: if false;
    }

    // Events collection
    match /events/{eventId} {
      // Anyone can read an event (judges with Event ID / QR code and organisers)
      allow read: if true;
      
      // Allow event creation by authenticated user OR guest organiser
      allow create: if (request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200);
      
      // Allow updates to event status, criteria, etc.
      allow update: if (request.auth != null && resource.data.organiserId == request.auth.uid)
                   || (resource.data.organiserId == 'guest_organiser' || !('organiserId' in resource.data) || resource.data.organiserId.matches('^guest_.*'));
      
      // Allow deletion by organiser
      allow delete: if (request.auth != null && resource.data.organiserId == request.auth.uid)
                   || (resource.data.organiserId == 'guest_organiser' || resource.data.organiserId.matches('^guest_.*'));

      // Judges subcollection - judges and organisers need to read/verify PINs and QR tokens
      match /judges/{judgeId} {
        allow read: if true;
        allow write: if true;
      }

      // Participants subcollection - judges need to read roster; organisers batch-import
      match /participants/{participantId} {
        allow read: if true;
        allow write: if true;
      }

      // Scores subcollection - Absolute Immutability: create allowed once with isLocked==true, update and delete forbidden
      match /scores/{scoreId} {
        allow read: if true;
        allow create: if request.resource.data.isLocked == true;
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
